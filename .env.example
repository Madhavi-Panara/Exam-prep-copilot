# ---------------------------------------------------------------------------
# Choose ONE AI provider. Uncomment the block you want to use.
# ---------------------------------------------------------------------------

# Option A: Anthropic Claude (paid API key from https://console.anthropic.com)
#LLM_PROVIDER=anthropic
#ANTHROPIC_API_KEY=your-key-here
   LLM_PROVIDER=gemini
   LLM_API_KEY=paste-your-key-here
   MODEL_NAME=gemini-2.5-flash
# MODEL_NAME=claude-sonnet-5-5

# Option B: Google Gemini - free tier, key from https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# LLM_API_KEY=your-gemini-key
# MODEL_NAME=gemini-2.5-flash

# Option C: Groq - free tier, key from https://console.groq.com/keys
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-key
# MODEL_NAME=llama-3.3-70b-versatile

# Option D: Ollama - runs on your own computer, no key, no internet (https://ollama.com)
# LLM_PROVIDER=ollama
# MODEL_NAME=llama3.1

# Option E: any other OpenAI-compatible service
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_API_KEY=your-key
# MODEL_NAME=model-name

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# "auto" uses ChromaDB if installed, otherwise the built-in keyword search.
VECTOR_BACKEND=auto

# Where the Streamlit app finds the backend
API_URL=http://127.0.0.1:8000
